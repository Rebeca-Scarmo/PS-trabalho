insumo[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF2CC"><B>INSUMO</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="id_insumo"><FONT POINT-SIZE="10"><B>PK</B> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><U>id_insumo</U></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="codigo"><FONT POINT-SIZE="10">UK </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">codigo</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="descricao"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">descricao</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="unidade_medida"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">unidade_medida</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="preco_ref"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">preco_ref</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">NUMERIC(12,2)</FONT></TD></TR></TABLE>>];
