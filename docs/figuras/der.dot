digraph G{rankdir=TB;nodesep=0.35;ranksep=0.7;newrank=true;node[shape=plaintext,fontname="Helvetica"];edge[fontname="Helvetica",fontsize=10,arrowsize=0.9];
obra[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#FFF2CC"><B>OBRA</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="id_obra"><FONT POINT-SIZE="10"><B>PK</B> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><U>id_obra</U></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nome"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">nome</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(80)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="bairro"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">bairro</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(60)</FONT></TD></TR></TABLE>>];
