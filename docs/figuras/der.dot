conferencia[label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#E1D5E7"><B>CONFERENCIA</B></TD></TR><HR/><TR><TD ALIGN="LEFT" PORT="id_conferencia"><FONT POINT-SIZE="10"><B>PK</B> </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11"><U>id_conferencia</U></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_requisicao"><FONT POINT-SIZE="10">FK </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id_requisicao</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="id_usuario_almoxarife"><FONT POINT-SIZE="10">FK </FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">id_usuario_almoxarife</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">INTEGER</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="nf_numero"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">nf_numero</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">VARCHAR(20)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="data_hora"><FONT POINT-SIZE="10">&#160;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="11">data_hora</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">TIMESTAMP</FONT></TD></TR></TABLE>>];
